{
    "layer": "top",
    "position": "top",
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 4,

    "modules-left": ["custom/fuzzel", "hyprland/window"],
    "modules-center": ["hyprland/workspaces", "clock"],
    "modules-right": ["custom/notifications", "pulseaudio", "tray", "custom/power"],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        }
    },

    "clock": {
        "format": "{:%H:%M - %a, %b %d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "pulseaudio": {
        "format": "Vol: {volume}%",
        "format-muted": "Muted",
        "on-click": "pavucontrol"
    },

    "custom/power": {
        "format": " ⏻ ",
        "on-click": "wlogout",
    },

    "custom/notifications":{
        "format": "  ",
        "on-click": "swaync-client -t",
    },    

    "tray": {
        "spacing": 10
    },

    "custom/fuzzel": {
        "format": " ",
        "on-click": "fuzzel",
    }
}
